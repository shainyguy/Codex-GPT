<%- include('partials/header', { title: 'Кабинет преподавателя' }) %>
<section class="section">
  <h1>Кабинет преподавателя</h1>
  <div class="stats">
    <div class="stat"><span>Оборот</span><strong><%= formatMoney(stats.gross) %></strong></div>
    <div class="stat"><span>Комиссия платформы</span><strong><%= formatMoney(stats.platform) %></strong></div>
    <div class="stat"><span>К выплате вам</span><strong><%= formatMoney(stats.payout) %></strong></div>
  </div>
  <div class="row">
    <a class="btn" href="/courses/new">+ Новый курс</a>
    <a class="btn ghost" href="/instructor/profile">Профиль мастера</a>
  </div>
  <section class="section grid">
    <% courses.forEach(course => { %>
      <article class="card">
        <h3><%= course.title %></h3>
        <p><%= course.category %> · <%= formatMoney(course.price_cents) %></p>
        <div class="row"><a class="btn small" href="/courses/<%= course.id %>/builder">Конструктор</a><a class="btn small ghost" href="/courses/<%= course.id %>">Страница курса</a></div>
      </article>
    <% }) %>
  </section>
</section>
<%- include('partials/footer') %>
