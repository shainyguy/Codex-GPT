<%- include('partials/header', { title: 'Новый курс' }) %>
<section class="section narrow card">
  <h1>Создание курса</h1>
  <% if (error) { %><p><%= error %></p><% } %>
  <form method="post" action="/courses" class="stack">
    <input name="title" placeholder="Название" required />
    <select name="category"><% categoryOptions.forEach(c => { %><option><%= c %></option><% }) %></select>
    <textarea name="description" rows="4" placeholder="Описание" required></textarea>
    <select name="level"><% levelOptions.forEach(l => { %><option><%= l %></option><% }) %></select>
    <select name="language"><% languageOptions.forEach(l => { %><option><%= l %></option><% }) %></select>
    <input name="duration_hours" type="number" min="1" placeholder="Длительность (часы)" />
    <input name="price" type="number" min="1" step="0.01" placeholder="Цена (RUB)" required />
    <input name="thumbnail_url" placeholder="URL обложки" />
    <button class="btn">Создать и открыть конструктор</button>
  </form>
</section>
<%- include('partials/footer') %>
