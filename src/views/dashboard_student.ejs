<%- include('partials/header', { title: 'Моё обучение' }) %>
<section class="section">
  <h1>Мои курсы</h1>
  <div class="grid">
    <% myCourses.forEach(course => { %>
      <article class="card">
        <h3><%= course.title %></h3>
        <p>Автор: <%= course.instructor_name %></p>
        <p>Куплен: <%= new Date(course.purchase_date).toLocaleDateString('ru-RU') %></p>
        <a href="/courses/<%= course.id %>" class="btn small">Открыть</a>
      </article>
    <% }) %>
  </div>
</section>
<section class="section card">
  <h2>Домашние задания — мои отправки</h2>
  <% submissions.forEach(s => { %>
    <p><strong><%= s.task_title %></strong> · оценка: <%= s.grade || '—' %> · фидбек: <%= s.feedback_text || 'ожидается' %></p>
  <% }) %>
</section>
<%- include('partials/footer') %>
