<%- include('partials/header', { title: 'Моё обучение' }) %>
<section class="section">
  <h1>Мои курсы</h1>
  <div class="grid">
    <% myCourses.forEach(course => { %>
      <article class="card glass">
        <h3><%= course.title %></h3>
        <p>Автор: <%= course.instructor_name %></p>
        <p class="muted">Куплен: <%= new Date(course.purchase_date).toLocaleDateString('ru-RU') %></p>
        <a href="/courses/<%= course.id %>" class="btn small">Продолжить</a>
      </article>
    <% }) %>
    <% if (!myCourses.length) { %><p>У вас пока нет курсов. Выберите в каталоге.</p><% } %>
  </div>
</section>
<%- include('partials/footer') %>
