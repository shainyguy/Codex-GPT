<%- include('partials/header', { title: 'Восстановление пароля' }) %>
<section class="section narrow card">
  <h1>Восстановление пароля</h1>
  <% if (sent) { %><p class="chip">Инструкция отправлена на email.</p><% } %>
  <form method="post" action="/forgot-password" class="stack">
    <input type="email" name="email" placeholder="Ваш email" required />
    <button class="btn">Отправить ссылку</button>
  </form>
</section>
<%- include('partials/footer') %>
