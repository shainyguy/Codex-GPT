<%- include('partials/header', { title: 'BeautyScale — Маркетплейс курсов' }) %>
<section class="hero">
  <div class="parallax layer l1"></div>
  <div class="parallax layer l2"></div>
  <div class="hero-content glass">
    <p class="chip">2025/2026 trend design</p>
    <h1>Платформа для обучения бьюти‑мастеров</h1>
    <p>Продавайте авторские курсы, автоматизируйте покупки и получайте выплаты. Платформа удерживает комиссию <%= commissionPercent %>% с каждой продажи.</p>
    <div class="hero-actions">
      <a href="/register" class="btn">Стать автором</a>
      <a href="#catalog" class="btn ghost">Смотреть курсы</a>
    </div>
  </div>
</section>

<section id="catalog" class="section">
  <h2>Каталог курсов</h2>
  <div class="grid">
    <% courses.forEach(course => { %>
      <article class="card glass">
        <div class="cover" style="background-image:url('<%= course.thumbnail_url || 'https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?q=80&w=1200&auto=format&fit=crop' %>')"></div>
        <div class="card-body">
          <p class="muted"><%= course.category %> · <%= course.level %></p>
          <h3><%= course.title %></h3>
          <p><%= course.description.slice(0, 120) %>...</p>
          <p class="muted">Автор: <%= course.instructor_name %> · Продаж: <%= course.sales_count %></p>
          <div class="row between">
            <strong><%= formatMoney(course.price_cents) %></strong>
            <a href="/courses/<%= course.id %>" class="btn small">Подробнее</a>
          </div>
        </div>
      </article>
    <% }) %>
    <% if (!courses.length) { %><p>Пока нет опубликованных курсов.</p><% } %>
  </div>
</section>
<%- include('partials/footer') %>
