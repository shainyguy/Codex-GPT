<%- include('partials/header', { title: 'BeautyScale — Маркетплейс курсов' }) %>
<section class="hero">
  <div class="parallax layer l1"></div>
  <div class="parallax layer l2"></div>
  <div class="glow g1"></div>
  <div class="glow g2"></div>
  <div class="hero-content glass">
    <p class="chip">Beauty EdTech • trend 2025/2026</p>
    <h1>Маркетплейс курсов для бьюти‑мастеров нового поколения</h1>
    <p>Запускайте свои программы, автоматизируйте продажи и выплаты. Платформа удерживает <%= commissionPercent %>% с каждой оплаты, остальное получает преподаватель.</p>
    <div class="hero-actions">
      <a href="/register" class="btn">Стать автором</a>
      <a href="#catalog" class="btn ghost">Изучить каталог</a>
    </div>
    <div class="hero-kpis">
      <div><span>Формат</span><strong>Видео + текст</strong></div>
      <div><span>Монетизация</span><strong><%= commissionPercent %>% комиссия</strong></div>
      <div><span>Запуск</span><strong>Railway-ready</strong></div>
    </div>
  </div>
</section>

<section id="catalog" class="section">
  <div class="section-head">
    <h2>Актуальные курсы</h2>
    <p class="muted">Трендовые программы по макияжу, колористике, бровям, ногтям и уходу.</p>
  </div>
  <div class="grid">
    <% courses.forEach(course => { %>
      <article class="card glass">
        <div class="cover" style="background-image:url('<%= course.thumbnail_url || 'https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?q=80&w=1200&auto=format&fit=crop' %>')"></div>
        <div class="card-body">
          <p class="muted"><%= course.category %> · <%= course.level %></p>
          <h3><%= course.title %></h3>
          <p><%= course.description.slice(0, 120) %>...</p>
          <p class="muted">Автор: <%= course.instructor_name %> · Продаж: <%= course.sales_count %></p>
          <div class="row between card-footer-row">
            <strong><%= formatMoney(course.price_cents) %></strong>
            <a href="/courses/<%= course.id %>" class="btn small">Подробнее</a>
          </div>
        </div>
      </article>
    <% }) %>
    <% if (!courses.length) { %><p class="muted">Пока нет опубликованных курсов.</p><% } %>
  </div>
</section>
<%- include('partials/footer') %>
