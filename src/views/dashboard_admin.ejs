<%- include('partials/header', { title: 'Админ панель' }) %>
<section class="section">
  <h1>Админ панель</h1>
  <div class="stats">
    <div class="stat glass"><span>Общий оборот</span><strong><%= formatMoney(stats.gross) %></strong></div>
    <div class="stat glass"><span>Доход платформы</span><strong><%= formatMoney(stats.commission) %></strong></div>
    <div class="stat glass"><span>Количество продаж</span><strong><%= stats.sales %></strong></div>
  </div>
  <h2>Топ курсов</h2>
  <div class="glass pad">
    <% topCourses.forEach(c => { %>
      <p><strong><%= c.title %></strong> — продаж: <%= c.sales %>, выручка: <%= formatMoney(c.revenue) %></p>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
