<%- include('partials/header', { title: 'Админ панель' }) %>
<section class="section">
  <h1>Админ панель</h1>
  <div class="stats">
    <div class="stat"><span>Общий оборот</span><strong><%= formatMoney(stats.gross) %></strong></div>
    <div class="stat"><span>Доход платформы</span><strong><%= formatMoney(stats.commission) %></strong></div>
    <div class="stat"><span>Количество продаж</span><strong><%= stats.sales %></strong></div>
  </div>
  <article class="card">
    <h3>Последние курсы</h3>
    <ul class="list-clean"><% topCourses.forEach(c=>{ %><li><%= c.title %></li><% }) %></ul>
  </article>
</section>
<%- include('partials/footer') %>
